<section
  class="pa"
  data-paper-archive
>
  <div class="pa__frame" data-pa-frame>
    <div
      class="pa__stage"
      data-pa-stage
      {% comment %} style="width: {{ section.settings.stage_width }}px; height: {{ section.settings.stage_height }}px;" {% endcomment %}
    >
      {%- for block in section.blocks -%}
        {%- assign s = block.settings -%}
        {%- if s.image != blank -%}
          <div
            class="pa__item{% if s.draggable %} is-draggable{% endif %}"
            data-pa-item
            style="
              --x: {{ s.x }}rem;
              --y: {{ s.y }}rem;
              --w: {{ s.width }}rem;
              --mx: {{ s.x_mobile | default: s.x }}rem;
              --my: {{ s.y_mobile | default: s.y }}rem;
              --mw: {{ s.width_mobile | default: s.width }}rem;
              z-index: {{ s.z_index }};
            "
            {{ block.shopify_attributes }}
          >
            {{
              s.image
              | image_url: width: 1000
              | image_tag:
                width: s.width,
                height: s.height,
                widths: '300, 500, 700, 1000',
                sizes: '(min-width: 1024px) 25vw, 40vw',
                loading: 'lazy',
                alt: s.image.alt,
                draggable: 'false'
            }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="logo">
    {{ 'i-mts.svg' | inline_asset_content }}
  </div>
</section>

{% stylesheet %}
  .pa {
    overflow: hidden;
    position: relative;
    width: 1440rem;
    height: 900rem;
    @media (width < 770px) {
      margin-top: 80rem;
      width: 400rem;
      height: 600rem;
    }
  }
  .pa .logo {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    padding-inline: var(--p-i);
  }
  .pa__frame {
    position: relative;
    width: 100%;
  }
  .pa__stage {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    /* transform: scale(var(--pa-scale, 1)); */
  }

  .pa__item {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    transform: rotate(var(--pa-rot, 0deg));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), filter 0.2s;
    user-select: none;
    -webkit-user-select: none;
    @media (width < 770px) {
      left: var(--mx);
      top: var(--my);
      width: var(--mw);
    }
  }
  .pa__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .pa__item.is-draggable {
    cursor: grab;
    touch-action: none;
  }
  .pa__item.is-draggable:hover:not(.is-dragging) {
    transform: rotate(calc(var(--pa-rot, 0deg) + 3deg)) translateY(-6px) scale(1.03);
  }
  .pa__item.is-dragging {
    cursor: grabbing;
    transition: filter 0.2s;
    filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.45));
  }
  @media (prefers-reduced-motion: reduce) {
    .pa__item {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
