{%- comment -%}
  Paper Archive: draggable collage section
  Place in /sections/paper-archive.liquid, then add it to the home page in the theme editor.
  Each image is a block, so everything can be positioned from the editor.
{%- endcomment -%}

<section
  class="pa"
  data-paper-archive
>
  <div class="pa__frame" data-pa-frame>
    <div
      class="pa__stage"
      data-pa-stage
      style="width: {{ section.settings.stage_width }}px; height: {{ section.settings.stage_height }}px;"
    >
      {%- for block in section.blocks -%}
        {%- assign s = block.settings -%}
        {%- if s.image != blank -%}
          <div
            class="pa__item{% if s.draggable %} is-draggable{% endif %}"
            data-pa-item
            data-x="{{ s.x }}"
            data-y="{{ s.y }}"
            style="
              left: {{ s.x }}px;
              top: {{ s.y }}px;
              width: {{ s.width }}px;
              {% comment %} height: {{ s.height }}px; {% endcomment %}
              z-index: {{ s.z_index }};
            "
            {{ block.shopify_attributes }}
          >
            {{
              s.image
              | image_url: width: 1000
              | image_tag:
                width: s.width,
                height: s.height,
                widths: '300, 500, 700, 1000',
                sizes: '(min-width: 1024px) 25vw, 40vw',
                loading: 'lazy',
                alt: s.image.alt,
                draggable: 'false'
            }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pa {
    width: 1440rem;
    height: 900rem;
    overflow: hidden;
  }
  .pa__frame {
    position: relative;
    width: 100%;
  }
  .pa__stage {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    transform: scale(var(--pa-scale, 1));
  }

  .pa__item {
    position: absolute;
    transform: rotate(var(--pa-rot, 0deg));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), filter 0.2s;
    user-select: none;
    -webkit-user-select: none;
  }
  .pa__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .pa__item.is-draggable {
    cursor: grab;
    touch-action: none;
  }
  .pa__item.is-draggable:hover:not(.is-dragging) {
    transform: rotate(calc(var(--pa-rot, 0deg) + 3deg)) translateY(-6px) scale(1.03);
  }
  .pa__item.is-dragging {
    cursor: grabbing;
    transition: filter 0.2s;
    filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.45));
  }
  @media (prefers-reduced-motion: reduce) {
    .pa__item {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var zCounter = 1000;

    function initCollage(root) {
      if (!root || root.dataset.paReady === 'true') return;
      root.dataset.paReady = 'true';

      var frame = root.querySelector('[data-pa-frame]');
      var stage = root.querySelector('[data-pa-stage]');
      var designW = parseFloat(root.dataset.stageW) || 1024;
      var scale = 1;

      function resize() {
        scale = frame.clientWidth / designW;
        stage.style.setProperty('--pa-scale', scale);
      }
      resize();

      var ro = new ResizeObserver(resize);
      ro.observe(frame);
      root._paObserver = ro;

      root.querySelectorAll('[data-pa-item].is-draggable').forEach(function (el) {
        var startX,
          startY,
          originX,
          originY,
          active = false;

        el.addEventListener('pointerdown', function (e) {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          active = true;
          startX = e.clientX;
          startY = e.clientY;
          originX = parseFloat(el.style.left) || 0;
          originY = parseFloat(el.style.top) || 0;
          el.setPointerCapture(e.pointerId);
          el.classList.add('is-dragging');
          el.style.zIndex = ++zCounter;
        });

        el.addEventListener('pointermove', function (e) {
          if (!active) return;
          el.style.left = originX + (e.clientX - startX) / scale + 'px';
          el.style.top = originY + (e.clientY - startY) / scale + 'px';
        });

        function end() {
          active = false;
          el.classList.remove('is-dragging');
        }
        el.addEventListener('pointerup', end);
        el.addEventListener('pointercancel', end);
      });
    }

    function initAll() {
      document.querySelectorAll('[data-paper-archive]').forEach(initCollage);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    // Theme editor: re-init when the section is added or re-rendered
    document.addEventListener('shopify:section:load', function (e) {
      var root =
        e.target.querySelector('[data-paper-archive]') || (e.target.matches('[data-paper-archive]') ? e.target : null);
      if (root) {
        root.dataset.paReady = 'false';
        initCollage(root);
      }
    });

    document.addEventListener('shopify:section:unload', function (e) {
      var root = e.target.querySelector('[data-paper-archive]');
      if (root && root._paObserver) root._paObserver.disconnect();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Paper Archive",
  "tag": "div",
  "class": "section-paper-archive",
  "settings": [
    { "type": "header", "content": "Canvas" },
    {
      "type": "number",
      "id": "stage_width",
      "label": "Design width (px)",
      "default": 1024,
      "info": "Positions below are in this coordinate space. The whole canvas scales to fit the screen."
    },
    { "type": "number", "id": "stage_height", "label": "Design height (px)", "default": 601 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Use a transparent PNG cut-out." },
        { "type": "number", "id": "x", "label": "X", "default": 100 },
        { "type": "number", "id": "y", "label": "Y", "default": 100 },
        { "type": "number", "id": "width", "label": "Width", "default": 200 },
        {
          "type": "number",
          "id": "z_index",
          "label": "Layer (z-index)",
          "default": 310,
          "info": "Higher sits on top."
        },
        { "type": "checkbox", "id": "draggable", "label": "Draggable", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paper Archive",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
