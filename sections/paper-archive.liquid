    function init() {
      const root = document.querySelector('[data-paper-archive]');
      if (!root || root.dataset.paReady === 'true') return;
      root.dataset.paReady = 'true';

      var desktopMq = window.matchMedia('(width > 770px)');

      // same formula as the html font-size in your CSS
      function remPx() {
        return window.innerWidth / (desktopMq.matches ? 1440 : 400);
      }

      root.querySelectorAll('[data-pa-item].is-draggable').forEach(function (el) {
        var startX,
          startY,
          originX,
          originY,
          rem,
          active = false;

        el.addEventListener('pointerdown', function (e) {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          active = true;
          rem = remPx();
          startX = e.clientX;
          startY = e.clientY;
          // position inside the stage in rem (ignores hover scale/rotate)
          originX = el.offsetLeft / rem;
          originY = el.offsetTop / rem;
          el.setPointerCapture(e.pointerId);
          el.classList.add('is-dragging');
          el.style.zIndex = ++zCounter;
        });

        el.addEventListener('pointermove', function (e) {
          if (!active) return;
          var x = originX + (e.clientX - startX) / rem;
          var y = originY + (e.clientY - startY) / rem;
          // write to the variables of the current breakpoint only
          var isMobile = !desktopMq.matches;
          el.style.setProperty(isMobile ? '--mx' : '--x', x + 'rem');
          el.style.setProperty(isMobile ? '--my' : '--y', y + 'rem');
        });

        function end() {
          active = false;
          el.classList.remove('is-dragging');
        }
        el.addEventListener('pointerup', end);
        el.addEventListener('pointercancel', end);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Theme editor: re-init when the section is added or re-rendered
    document.addEventListener('shopify:section:load', function (e) {
      var root =
        e.target.querySelector('[data-paper-archive]') || (e.target.matches('[data-paper-archive]') ? e.target : null);
      if (root) {
        root.dataset.paReady = 'false';
        init();
      }
    });

    document.addEventListener('shopify:section:unload', function (e) {
      var root = e.target.querySelector('[data-paper-archive]');
      if (root && root._paObserver) root._paObserver.disconnect();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Paper Archive",
  "tag": "div",
  "class": "section-paper-archive",
  "settings": [
    { "type": "header", "content": "Canvas" },
    {
      "type": "number",
      "id": "stage_width",
      "label": "Design width (px)",
      "default": 1440,
      "info": "Positions below are in this coordinate space. The whole canvas scales to fit the screen."
    },
    {
      "id": "stage_width_mobile",
      "label": "Mobile design width",
      "type": "number",
      "default": 400
    },
    { "type": "number", "id": "stage_height", "label": "Design height (px)", "default": 900 },
    { "type": "number", "id": "stage_height_mobile", "label": "Mobile Design height (px)", "default": 600 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Use a transparent PNG cut-out." },
        { "type": "number", "id": "x", "label": "X", "default": 100 },
        { "type": "number", "id": "y", "label": "Y", "default": 100 },
        { "type": "number", "id": "width", "label": "Width", "default": 200 },
        { "type": "number", "id": "x_mobile", "label": "X Mobile", "default": 100 },
        { "type": "number", "id": "y_mobile", "label": "Y Mobile", "default": 100 },
        { "type": "number", "id": "width_mobile", "label": "Width Mobile", "default": 200 },
        {
          "type": "number",
          "id": "z_index",
          "label": "Layer (z-index)",
          "default": 310,
          "info": "Higher sits on top."
        },
        { "type": "checkbox", "id": "draggable", "label": "Draggable", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paper Archive",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
