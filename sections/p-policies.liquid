{{ 's-p-policies.css' | asset_url | stylesheet_tag }}

<div class="p">
  <h1>policies</h1>
  <section class='policy'>
    <div class="l">
      <h2>RETURN & EXCHANGE POLICY</h2>
    </div>
    <div class="r">
      <p>
        You have 3 days from the date of delivery to return your order.
        <br />
        <br />
        Returned items must be unworn, unused, and in their original condition, with all tags and packaging intact.
        Items that do not meet these conditions will not be accepted and will be returned at your cost.
        <br />
        <br />
        Refunds are available on full-priced styles only.
        <br />
        <br />
        Full-price items can be returned for a store credit or size exchange, subject to availability.
        <br />
        <br />
        Sale items are not eligible for refund. Items marked as “Sale” or discounted through a promotional code or flash
        sale are considered final.
        <br />
        <br />
        Final Sale items are not eligible for refund or store credit. Styles marked “Final Sale — size exchange only”
        can be exchanged for a different size, if available.
      </p>
    </div>
  </section>

  <section>
    <div class="l">
      <h2>SHIPPING POLICY</h2>
    </div>
    <div class="r">
      <p>
        Orders are shipped within 2-5 working days after processing.
        <br />
        <br />
        If an item you purchased becomes unavailable, you will be notified by email and offered a suitable replacement,
        store credit, or refund.
        <br />
        <br />
        All orders are shipped from our Cairo studio within 1 – 2 business days of processing. Orders placed on weekends
        or public holidays will be processed the next working day.
        <br />
        <br />
        For order or product inquiries, please contact us
      </p>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "policies",
  "settings": []
}
{% endschema %}
