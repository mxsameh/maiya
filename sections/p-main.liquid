      {{ 'i-mts.svg' | inline_asset_content }}
    </div>
  </section>
  <section
    class="s-collection"
  >
    <ul>
  </section>
</div>

{% schema %}
{
  "name": "main",
  "settings": [
    {
      "id": "img1",
      "label": "Image 1",
