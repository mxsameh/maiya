{{ 's-p-main.css' | asset_url | stylesheet_tag }}

<div class="p">
  <section class="s-playground">
    <figure>
      {{ section.settings.playground_img | image_url: width: 800 | image_tag }}
    </figure>
  </section>
  <section
    class="s-intro"
  >
    <div class="gallery">
      <figure>
        {{ section.settings.img1 | image_url: width: 800 | image_tag }}
      </figure>
      <figure>
        {{ section.settings.img2 | image_url: width: 800 | image_tag }}
      </figure>
      <figure>
        {{ section.settings.img3 | image_url: width: 800 | image_tag }}
      </figure>
      <figure class="m-o">
        {{ section.settings.img4 | image_url: width: 800 | image_tag }}
      </figure>
    </div>
    <h2>not strictly activewear <br /> not quite everyday wear <span> something in between </span></h2>
  </section>
</div>

{% schema %}
{
  "name": "main",
  "settings": [
    {
      "id": "playground_img",
      "label": "Playground Image",
      "type": "image_picker"
    },
    {
      "id": "img1",
      "label": "Image 1",
      "type": "image_picker"
    },
    {
      "id": "img2",
      "label": "Image 2",
      "type": "image_picker"
    },
    {
      "id": "img3",
      "label": "Image 3",
      "type": "image_picker"
    },
    {
      "id": "img4",
      "label": "Image 4",
      "type": "image_picker"
    }
  ]
}
{% endschema %}
