{{ 's-p-main.css' | asset_url | stylesheet_tag }}

<div class="p">
  <section class="s-playground">
    <div class="b">
      {{ 'i-mts.svg' | inline_asset_content }}
    </div>
  </section>
  <section
    class="s-intro"
  >
    <div class="gallery">
      <figure>
        {{ section.settings.img1 | image_url: width: 400 | image_tag }}
      </figure>
      <figure>
        {{ section.settings.img2 | image_url | image_tag }}
      </figure>
      <figure>
        {{ section.settings.img3 | image_url | image_tag }}
      </figure>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "main",
  "settings": [
    {
      "id": "img1",
      "label": "Image 1",
      "type": "image_picker"
    },
    {
      "id": "img2",
      "label": "Image 2",
      "type": "image_picker"
    },
    {
      "id": "img3",
      "label": "Image 3",
      "type": "image_picker"
    }
  ]
}
{% endschema %}
