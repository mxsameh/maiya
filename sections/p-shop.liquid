{{ 's-p-shop.css' | asset_url | stylesheet_tag }}
{{ 's-product-card.css' | asset_url | stylesheet_tag }}

{% liquid
  assign collection = collections.shop
%}

<div class="p">
  <section class="s-intro">
    <h1>maiya <br /> the foundation</h1>
    <figure class="img1"></figure>
    <figure class="img2"></figure>
  </section>
  <section class="s-collection">
    <h2>not strictly activewear <br /> not quite everyday wear <span> something in between </span></h2>
    <ul class="products">
      {% for product in collection.products %}
        <li>
          {% render 'product-card', product: product %}
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

{% schema %}
{
  "name": "shop",
  "settings": []
}
{% endschema %}
