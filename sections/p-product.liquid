{{ 's-p-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'j-product.js' | asset_url }}" defer></script>
<script src="{{ 'j-accordion.js' | asset_url }}" defer></script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  if current_variant.compare_at_price > current_variant.price
    assign compare_at_price = current_variant.compare_at_price
  endif
%}

<div class="p">
  <div class="product">
    <div class="l">
      <h1 class="p_title">{{ product.title }}</h1>
      <p class="p_desc">{{ product.description }}</p>
      {% render 'product-form' %}
      <div class="p_details">
        {% render 'accordion', heading: 'details', content: product.metafields.custom.details, default: '100% Cotton' %}
        {% render 'accordion',
          heading: 'size & fit',
          content: product.metafields.custom.size_and_fit,
          default: '100% Cotton'
        %}
      </div>
    </div>

    <div class="r">
      {% render 'st-gallery' %}
    </div>

    {% comment %}
      {% render 'product-gallery' %}
        PRODUCT INFO
          <div class="product_price">
            <div class="current-price">
              <span>{{ current_variant.price | money_without_currency | remove: '.00' }}</span>
              {{ shop.currency }}
            </div>

            <div
              class="compare-price {%unless compare_at_price %}d-n{% endunless %}"
            >
              <span>
                {{ current_variant.compare_at_price | money_without_currency | remove: '.00' }}
              </span>
              {{ shop.currency }}
            </div>
          </div>

            {% liquid
              assign y = false
              if product.metafields.custom.fit or product.metafields.custom.material
                assign y = true
              endif
            %}

            {% if y %}
              {% assign x = 'Materials: '
                | append: product.metafields.custom.material
                | append: '<br>'
                | append: 'Fit: '
                | append: product.metafields.custom.fit
              %}

            {% endif %}
    {% endcomment %}
  </div>

  {% render 'recommended-products' %}
</div>

<script>
  const product = {{ product | json }};
</script>

{% schema %}
{
  "name": "product",
  "settings": []
}
{% endschema %}
