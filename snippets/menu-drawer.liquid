{{ 's-menu-drawer.css' | asset_url | stylesheet_tag }}

<div id="menu-drawer" class="d-n">
  <nav>
    {% for link in linklists['mobile-menu'].links -%}
      <div class="d_item">
        <div class="d_item-h">
          <span>
            {{ link.title | upcase | link_to: link.url }}
          </span>
        </div>
      </div>
    {%- endfor %}
  </nav>
  <button id="cart-btn">
    cart (<span id="cart-count" class="h_cb_count">{{- cart.item_count -}}</span>)
  </button>
</div>
