{{ 's-product-form.css' | asset_url | stylesheet_tag }}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign available = current_variant.available
%}

{% form 'product', product, class: 'pf' %}
  <input type="hidden" id="variant-id" name="id" value="{{ current_variant.id }}">
  {% comment %}
    Options
  {% endcomment %}
  <div class="p_options">
    {% unless product.has_only_default_variant %}
      {% for option in product.options_with_values %}
        {% render 'product-option', option: option %}
      {% endfor %}
    {% endunless %}
  </div>

  {% comment %}
    Add to Cart
  {% endcomment %}
  <div class="p_atc">
    <button
      type="submit"
      {% unless available %}
        disabled
      {% endunless %}
    >
      <div class="atc">
        {%- if available -%}
          add to cart
        {%- else -%}
          sold out
        {%- endif -%}
      </div>
      <div class="p_price{% unless available %} d-n{% endunless %}">
        <span>{{ current_variant.price | money_without_currency | remove: '.00' }}</span>
        {{ shop.currency }}
      </div>
    </button>
  </div>
{% endform %}
